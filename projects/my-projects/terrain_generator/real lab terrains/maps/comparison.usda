#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def "Looks"
    {
        def Material "grey"
        {
            token outputs:surface.connect = </World/Looks/grey/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6382832, 0.6559307, 0.6209159)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "green"
        {
            token outputs:surface.connect = </World/Looks/green/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.34239164, 0.60382736, 0.10048151)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }
    }

    def "PhysicsMaterials"
    {
        def Material "grey" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 1
            custom bool physxMaterial:compliantContactAccelerationSpring = 0
            custom float physxMaterial:compliantContactDamping = 0
            custom float physxMaterial:compliantContactStiffness = 0
            custom token physxMaterial:frictionCombineMode = "average"
            custom token physxMaterial:restitutionCombineMode = "average"
        }

        def Material "green" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 1
            custom bool physxMaterial:compliantContactAccelerationSpring = 0
            custom float physxMaterial:compliantContactDamping = 0
            custom float physxMaterial:compliantContactStiffness = 0
            custom token physxMaterial:frictionCombineMode = "average"
            custom token physxMaterial:restitutionCombineMode = "average"
        }
    }

    def "Terrain"
    {
        def Mesh "grey_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-2, -3, -0.1), (10, 0, 0)]
            int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
            int[] faceVertexIndices = [4, 5, 6, 4, 6, 7, 0, 2, 1, 0, 3, 2, 0, 1, 5, 0, 5, 4, 1, 2, 6, 1, 6, 5, 2, 3, 7, 2, 7, 6, 3, 0, 4, 3, 4, 7]
            rel material:binding = </World/Looks/grey>
            rel material:binding:physics = </World/PhysicsMaterials/grey>
            uniform token physics:approximation = "none"
            bool physics:collisionEnabled = 1
            point3f[] points = [(-2, -3, -0.1), (10, -3, -0.1), (10, 0, -0.1), (-2, 0, -0.1), (-2, -3, 0), (10, -3, 0), (10, 0, 0), (-2, 0, 0)]
            color3f[] primvars:displayColor = [(0.6382832, 0.6559307, 0.6209159)]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "green_1" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-2, 0, -0.1), (10, 3, 0)]
            int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
            int[] faceVertexIndices = [4, 5, 6, 4, 6, 7, 0, 2, 1, 0, 3, 2, 0, 1, 5, 0, 5, 4, 1, 2, 6, 1, 6, 5, 2, 3, 7, 2, 7, 6, 3, 0, 4, 3, 4, 7]
            rel material:binding = </World/Looks/green>
            rel material:binding:physics = </World/PhysicsMaterials/green>
            uniform token physics:approximation = "none"
            bool physics:collisionEnabled = 1
            point3f[] points = [(-2, 0, -0.1), (10, 0, -0.1), (10, 3, -0.1), (-2, 3, -0.1), (-2, 0, 0), (10, 0, 0), (10, 3, 0), (-2, 3, 0)]
            color3f[] primvars:displayColor = [(0.34239164, 0.60382736, 0.10048151)]
            uniform token subdivisionScheme = "none"
        }
    }
}

