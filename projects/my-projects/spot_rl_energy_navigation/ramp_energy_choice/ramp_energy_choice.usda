        def Xform "Cell_0_3_t1_asphalt_detour" (
            prepend references = @../../terrain_generator/real_terrains.usd@</World/Grid/Cell_0_4_t1_asphalt>
        )
        {
            double3 xformOp:translate = (-6, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            over "terrain"
            {
                over "mesh" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/Materials/t1_asphalt_mat>
                }
            }
        }

        def Xform "Cell_0_5_t1_asphalt_detour" (
