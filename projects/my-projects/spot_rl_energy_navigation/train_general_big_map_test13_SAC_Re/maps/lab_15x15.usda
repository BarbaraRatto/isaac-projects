    def "Looks"
    {
        def Material "grey"
        {
            token outputs:surface.connect = </World/Looks/grey/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6382832, 0.6559307, 0.6209159)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "black"
        {
            token outputs:surface.connect = </World/Looks/black/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0015479876, 0.0015479876, 0.0015479876)
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }
    }

    def "PhysicsMaterials"
    {
        def Material "grey" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 1
            custom bool physxMaterial:compliantContactAccelerationSpring = 0
            custom float physxMaterial:compliantContactDamping = 0
            custom float physxMaterial:compliantContactStiffness = 0
            custom token physxMaterial:frictionCombineMode = "average"
            custom token physxMaterial:restitutionCombineMode = "average"
        }

        def Material "black" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.08
            float physics:restitution = 0
            float physics:staticFriction = 0.1
            custom bool physxMaterial:compliantContactAccelerationSpring = 0
            custom float physxMaterial:compliantContactDamping = 0
            custom float physxMaterial:compliantContactStiffness = 0
            custom token physxMaterial:frictionCombineMode = "average"
            custom token physxMaterial:restitutionCombineMode = "average"
        }
    }
